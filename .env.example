# ==============================================================================
# OCTOFLEET — YACHT INVENTORY & FLEET MANAGEMENT PLATFORM
# Copy this file to .env.local and fill in your credentials.
# If credentials are omitted, OctoFleet runs in interactive Stateful Demo Mode
# with realistic maritime seed data and clearly labeled demo integrations.
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Sheets API Configuration (Server-Side Only - Never Exposed to Client)
GOOGLE_SERVICE_ACCOUNT_EMAIL=octofleet-sync@your-gcp-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# Application Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
